{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "databridge-pro",
    "version":  "0.1.0",
    "identifier":  "com.databridgepro.app",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://localhost:5174",
                  "beforeDevCommand":  "npm run dev",
                  "beforeBuildCommand":  ""
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "DataBridge Pro",
                                    "width":  800,
                                    "height":  600,
                                    "resizable":  true,
                                    "fullscreen":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "externalBin":  [
                                       "bin/local-api"
                                   ],
                   "resources":  [
                                     "bin/workers/*"
                                 ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "android":  {
                                   "debugApplicationIdSuffix":  ".debug"
                               }
               }
}
