{
  "name": "databridge-pro",
  "version": "1.0.0",
  "description": "DataBridge Pro — AmiBroker Real-Time Data Feed Bridge",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:gui\" --names \"API,GUI\" --prefix-colors \"cyan,magenta\"",
    "dev:desktop": "concurrently \"npm run dev:api\" \"npm run dev:tauri\" --names \"API,TAURI\" --prefix-colors \"cyan,blue\"",
    "dev:api": "npm run dev --prefix local-api",
    "dev:gui": "npm run dev --prefix gui-app",
    "dev:tauri": "npm run tauri dev --prefix gui-app",
    "build": "npm run build --prefix gui-app",
    "test": "npm run test:api && npm run test:gui",
    "test:api": "npm run test --prefix local-api",
    "test:gui": "npm run test --prefix gui-app",
    "install:all": "npm install --prefix local-api && npm install --prefix gui-app"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
