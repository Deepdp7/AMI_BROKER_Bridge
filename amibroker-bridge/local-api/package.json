{
  "name": "databridge-local-api",
  "version": "1.0.0",
  "description": "DataBridge Pro — Local Express API (localhost:7890)",
  "main": "dist/server.js",
  "bin": "dist/bundle.js",
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": [
      "node_modules/fyers-api-v3/**/*"
    ],
    "options": [
      "max_old_space_size=8192"
    ]
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "build:bin": "esbuild src/server.ts --bundle --platform=node --target=node18 --external:fyers-api-v3 --outfile=dist/bundle.js && node scripts/build-sea.js",
    "start": "node dist/server.js",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.0",
    "express": "^4.21.2",
    "fyers-api-v3": "^2.1.0",
    "kiteconnect": "^5.3.0",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "uuid": "^11.0.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "pkg": "^5.8.1",
    "postject": "^1.0.0-alpha.6",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
