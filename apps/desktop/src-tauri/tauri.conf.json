{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DataBridge Pro",
  "version": "0.1.0",
  "identifier": "com.databridgepro.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DataBridge Pro",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0e0e0e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/local-api"
    ],
    "shortDescription": "Live and historical market data from Indian brokers into AmiBroker",
    "longDescription": "DataBridge Pro streams live ticks and 1-minute history from Fyers, Zerodha Kite, Dhan, Flattrade, Shoonya, Upstox and Angel One into AmiBroker charts.",
    "copyright": "© 2026 DataBridge Pro",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "../../../branding/installer/header-150x57.bmp",
        "sidebarImage": "../../../branding/installer/sidebar-164x314.bmp"
      },
      "wix": {
        "bannerPath": "../../../branding/installer/banner-493x58.bmp",
        "dialogImagePath": "../../../branding/installer/dialog-493x312.bmp"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
